# ===== AI Placement Mentor - Backend Environment Config =====

# LLM Provider: choose "openai", "anthropic", or "mock"
# "mock" runs the app with realistic canned AI responses — no API key needed.
# This is great for offline demos / hackathon judging rounds.
LLM_PROVIDER=mock

# If using OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# If using Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Firebase
# Path to your Firebase service account JSON (download from Firebase Console)
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
# Set to "true" to run without Firebase using an in-memory store (for quick demos)
USE_MOCK_DB=true

# Flask
FLASK_ENV=development
FLASK_PORT=5000
MAX_UPLOAD_SIZE_MB=10
